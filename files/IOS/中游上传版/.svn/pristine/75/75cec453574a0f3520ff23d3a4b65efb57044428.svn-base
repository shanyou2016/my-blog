- (void)adressBtnClick:(UIButton *)btn{
    NSLog(@"地址点了%@",btn.titleLabel);
    [btn setTitle:@"点了" forState:UIControlStateNormal];
}
- (void)searchBtnClick{
    NSLog(@"搜索点了");
}


@end
