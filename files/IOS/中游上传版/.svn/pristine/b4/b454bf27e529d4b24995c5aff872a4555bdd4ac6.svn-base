- (void)viewDidLoad {
    [super viewDidLoad];
    // 对 subviews 的初始化写在这里
    [self setupSections];

}
- (void)setupSections
{
}
- (NSInteger)numberOfSectionsInTableView:(UITableView *)tableView {
    
    return self.sectionArray.count;
}

- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section {
    
    HgTableViewSectionModel *sectionModel = self.sectionArray[section];
    return sectionModel.itemArray.count;
    
}
- (UITableViewCell *)qmui_tableView:(UITableView *)tableView cellWithIdentifier:(NSString *)identifier {
    HgTableViewBaseCell *cell = [tableView dequeueReusableCellWithIdentifier:identifier];
    if (!cell) {
        cell = [[HgTableViewBaseCell alloc]initWithStyle:UITableViewCellStyleDefault reuseIdentifier:identifier];
    }
    return cell;
}

- (UITableViewCell *)tableView:(UITableView *)tableView cellForRowAtIndexPath:(NSIndexPath *)indexPath
{

    
    HgTableViewBaseCell *cell = [self qmui_tableView:tableView cellWithIdentifier:@"setting"];
    HgTableViewSectionModel *sectionModel = self.sectionArray[indexPath.section];
    HgTableViewRowModel *itemModel = sectionModel.itemArray[indexPath.row];
    cell.item = itemModel;
    cell.delegate =self;
    return cell;
}
- (CGFloat)tableView:(UITableView *)tableView heightForHeaderInSection:(NSInteger)section
{
    HgTableViewSectionModel *sectionModel = self.sectionArray[section];

    return sectionModel.sectionHeaderHeight;

}

-(UIView *)tableView:(UITableView *)tableView viewForHeaderInSection:(NSInteger)section{
    HgTableViewSectionModel *sectionModel = self.sectionArray[section];

    UIView * sectionView= [[UIView alloc] initWithFrame:CGRectMake(0, 0, SC_WIDTH, sectionModel.sectionHeaderHeight)];
    sectionView.backgroundColor = CellBG_Color;
    UILabel * nameLable =createLab(sectionView, [UIColor blackColor], LabelFont, NSTextAlignmentLeft);
    //设置背景颜色
    if (sectionModel.sectionHeaderBgColor) {
        sectionView.backgroundColor = sectionModel.sectionHeaderBgColor;
    } else {
        sectionView.backgroundColor =CellBG_Color;
    }
    //设置文本颜色
    if (sectionModel.detailTextColor) {
        nameLable.textColor = sectionModel.detailTextColor;
    } else {
        nameLable.textColor = [UIColor blackColor];
    }
    //设置文本字体
    if (sectionModel.detailTextFont) {
        nameLable.font  = sectionModel.detailTextFont;
    } else {
        nameLable.font = [UIFont systemFontOfSize:LabelFont];
    }
    nameLable.text = sectionModel.sectionHeaderName;
    [nameLable mas_makeConstraints:^(MASConstraintMaker *make) {
        make.left.mas_equalTo(sectionView.mas_left).offset(15);
        make.right.mas_equalTo(sectionView.mas_right).offset(-15);
        make.top.mas_equalTo(sectionView.mas_top).offset(0);
        make.bottom.mas_equalTo(sectionView.mas_bottom).offset(0);
    }];
    
    return sectionView;
}
- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)indexPath
{
    [tableView deselectRowAtIndexPath:indexPath animated:YES];
    HgTableViewSectionModel *sectionModel = self.sectionArray[indexPath.section];
    HgTableViewRowModel *itemModel = sectionModel.itemArray[indexPath.row];
    NSLog(@"点击的为%ld",indexPath.row);

    if (itemModel.executeCode) {
        itemModel.executeCode();
    }
}
- (CGFloat)tableView:(UITableView *)tableView heightForRowAtIndexPath:(NSIndexPath *)indexPath {
    return 55.67;
}
-(void)TextFiledControlEventEditingChanged:(UITextField *)mytextField{
    NSLog(@"tag为%ld-------输入的文字为%@",(long)mytextField.tag,mytextField.text);
}
-(void)TextFiledControlEventEndEditor:(UITextField *)mytextField{
    NSLog(@"tag为%ld----失去焦点时%@",(long)mytextField.tag,mytextField.text);
}


-(void)reloadTableView{
    dispatch_async(dispatch_get_main_queue(), ^{
        [self.tableView reloadData];

    });
}

@end
