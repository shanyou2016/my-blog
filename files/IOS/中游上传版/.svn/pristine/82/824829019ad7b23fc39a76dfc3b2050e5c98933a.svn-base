#import "ZYMainSerachView.h"

@implementation ZYMainSerachView

/*
// Only override drawRect: if you perform custom drawing.
// An empty implementation adversely affects performance during animation.
- (void)drawRect:(CGRect)rect {
    // Drawing code
}
*/

- (CGSize)intrinsicContentSize{
    
    return UILayoutFittingExpandedSize;
    
}

-(instancetype) ZYMainSerachView{
    
    
    NSBundle *bundle=[NSBundle mainBundle];
    NSArray *objs=[bundle loadNibNamed:@"ZYMainSerachView" owner:nil options:nil];
    return [objs lastObject];
    
}

-(instancetype)initView{
    
    if (self = [super init]) {
        self = [self ZYMainSerachView];
        
        //只需要设置layer层的两个属性
        //设置圆角
        self.layer.cornerRadius =6;
        
        //将多余的部分切掉
        self.layer.masksToBounds = YES;
        
         [self.adressBtn addTarget:self action:@selector(adressBtnClick:) forControlEvents:UIControlEventTouchUpInside];
        [self.searchBtn addTarget:self action:@selector(searchBtnClick) forControlEvents:UIControlEventTouchUpInside];
    }
    
    return self;
    
}

#pragma mark -
-(void)adressBtnClick:(id)sender{
    if ([_delegate respondsToSelector:@selector(adressBtnClick:)]) { //
        [_delegate adressBtnClick:sender]; // 通知执行协议方法
    }
}
-(void)searchBtnClick{
    if ([_delegate respondsToSelector:@selector(searchBtnClick)]) { //
        [_delegate searchBtnClick]; // 通知执行协议方法
    }
}
@end
