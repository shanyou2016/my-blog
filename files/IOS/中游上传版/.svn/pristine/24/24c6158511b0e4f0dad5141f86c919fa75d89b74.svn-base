    m_Line = [[UIView alloc] init];
    m_Line.backgroundColor = RGB(240, 240, 240, 1.0);
    //    m_Line.backgroundColor = [UIColor redColor];
    [self.contentView addSubview:m_Line];
    SYIconView* tiltleLab = [array2_2 objectAtIndex:0];
    [m_Line mas_makeConstraints:^(MASConstraintMaker *make)
     {
         make.left.equalTo(self.contentView.mas_left).with.offset(spacing);
         make.right.equalTo(self.contentView.mas_right).with.offset(-spacing);
         make.top.equalTo(tiltleLab.mas_bottom).with.offset(15);
         make.height.equalTo(@(4));
     }];
    
}

-(void)mbtnAction:(UIButton *)sender{
    NSLog(@"tag = %ld",(long)sender.tag);
    NSUInteger tag = sender.tag;
    
    
    switch (tag) {
        case 0://2手房
        {
            UIViewController *vc = [UIViewController new];
            vc.view.backgroundColor = BG_Color;
            NSString *str = [NSString stringWithFormat:@"2手房 "];
            vc.title = str;
            [_tabVC.navigationController pushViewController:vc animated:YES];
            break;
            
            
        }
        case 1://租房
        {

            break;
        }
        case 2://新房
