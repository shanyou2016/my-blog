    NSMutableArray *titleArray = [[NSMutableArray alloc] initWithObjects:@"二手房",@"租房",@"新房",nil];
    NSMutableArray *titleImgArray = [[NSMutableArray alloc] initWithObjects:@"alright1",@"alright2",@"alright3",nil];
    NSMutableArray *array2 = [NSMutableArray new];
    for (int i = 0; i < titleArray.count; i ++) {
        SYIconView *mbtn = [[SYIconView alloc] initView];
        NSString *mbtnImg = [titleImgArray objectAtIndex:i];
        UIImage *pic = [ UIImage imageNamed:mbtnImg];
        [mbtn.mImgV setImage:pic];
        mbtn.mNameLB.text = [titleArray objectAtIndex:i];
        mbtn.mBtnV.tag = i;
        [mbtn.mBtnV addTarget:self action:@selector(mbtnAction:) forControlEvents:UIControlEventTouchUpInside];
        [self addSubview:mbtn];
        [array2 addObject:mbtn]; //保存添加的控件
    }
    // 等间隔排列 - 多个固定大小固定，间隔空隙变化
    [array2 mas_distributeViewsAlongAxis:MASAxisTypeHorizontal withFixedItemLength:60 leadSpacing:10 tailSpacing:10];
    [array2 mas_makeConstraints:^(MASConstraintMaker *make) { //数组额你不必须都是view
        make.top.equalTo(@14);
        make.height.equalTo(@70);
    }];
    
