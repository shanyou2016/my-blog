    NSMutableArray *titleArray2 = [[NSMutableArray alloc] initWithObjects:@"线上报盘",@"交易进度",@"历史成交",nil];
    NSMutableArray *title2ImgArray = [[NSMutableArray alloc] initWithObjects:@"alright21",@"alright22",@"alright23",nil];
    NSMutableArray *array2_2 = [NSMutableArray new];
    for (int i = 0; i < titleArray2.count; i ++) {
        SYIconView *mbtn = [[SYIconView alloc] initView];
        NSString *mbtnImg =  [title2ImgArray objectAtIndex:i];
        UIImage *pic = [ UIImage imageNamed:mbtnImg];
        [mbtn.mImgV setImage:pic];
        mbtn.mNameLB.text = [titleArray2 objectAtIndex:i];
        mbtn.mBtnV.tag = 10+i;
        [mbtn.mBtnV  addTarget:self action:@selector(mbtnAction:) forControlEvents:UIControlEventTouchUpInside];
        [self addSubview:mbtn];
        [array2_2 addObject:mbtn]; //保存添加的控件
    }
    // 等间隔排列 - 多个固定大小固定，间隔空隙变化
    [array2_2 mas_distributeViewsAlongAxis:MASAxisTypeHorizontal withFixedItemLength:60 leadSpacing:10 tailSpacing:10];
    [array2_2 mas_makeConstraints:^(MASConstraintMaker *make) { //数组额你不必须都是view
        make.top.equalTo(@104);
        make.height.equalTo(@70);
    }];
    
    
    
    //==================================================================================================
